# ==============================================================================
# Environment Configuration Template
# Used by Ansible or local development
# ==============================================================================

# Application Settings
APP_NAME="OmniPulse Commerce Portal"
APP_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=super-secret-key-change-in-production-123456789

# Authentication (Default Admin Account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Database Settings
# Supported DB_TYPE: sqlite, postgresql, mysql
DB_TYPE=mysql
DB_NAME=dashboard
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password123
